# --- Database ---
POSTGRES_USER=truthtrace
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=truthtrace
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_dev_secret_do_not_use_in_production
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- Bootstrap admin (created on first startup only) ---
FIRST_ADMIN_EMAIL=admin@truthtrace.com
FIRST_ADMIN_PASSWORD=ChangeMe123!

# --- Analysis engine ---
# lexical  = no model download, deterministic (default, works offline out of the box)
# embedding = local sentence-transformers model
ANALYZER_BACKEND=lexical
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MODEL_CACHE_DIR=/models
SIMILARITY_LINK_THRESHOLD=0.55

# --- Evidence storage ---
EVIDENCE_DIR=/storage/evidence
MAX_EVIDENCE_MB=50

# --- Frontend ---
VITE_API_URL=http://localhost:8000
